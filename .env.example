# Public example only. Do NOT add your real .env to GitHub.
HOMEOS_IMAGE=ghcr.io/ozkernel/homeos:1.0.0

# Host only by default. Change to 0.0.0.0 only on a trusted LAN.
HOMEOS_BIND=127.0.0.1
HOMEOS_HOST_PORT=3080

# Leave blank for first-run administrator setup.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD_FILE=

# Container user for /config and MyFiles. Unraid default: 99 (nobody) and 100 (users).
PUID=99
PGID=100
UMASK=022

HOMEOS_DEMO=true
HOMEOS_LOCAL_BOOTSTRAP=false
HOMEOS_LOG_LEVEL=INFO
HOMEOS_SECURITY_LOGGING=true
HOMEOS_HTTPS_ONLY=false
HOMEOS_SHUTDOWN_MS=8000
HOMEOS_TRUSTED_PROXIES=
MYFILES_STORAGE_PATH=/app/data/myfiles
TZ=Australia/Melbourne

# Optional host folders for NEW installs. Set both together. For existing installs, migrate both volumes first.
# HOMEOS_CONFIG_HOST_PATH=/path/to/homeos/config
# MYFILES_HOST_PATH=/path/to/homeos/myfiles
